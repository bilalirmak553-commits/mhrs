                        <div class="ant-row ant-form-item login-button-items">
                            <div class="ant-col ant-form-item-control-wrapper">
                                <div class="ant-form-item-control"><span class="ant-form-item-children">
                                        <button type="button" id="edevletGirisBtn"
                                            class="ant-btn login-form-button login-button edevlet-btn ant-btn-block">Giriş
                                            Yap</button>
                                    </span></div>
                            </div>
                        </div>
                        <p id="edevletMsg" class="login-edevlet-msg" role="status" aria-live="polite">
                            <span class="login-msg-icon login-msg-icon-warn" aria-hidden="true">
                                <svg viewBox="64 64 896 896" focusable="false" data-icon="exclamation-circle"
                                    width="1em" height="1em" fill="currentColor" aria-hidden="true">
                                    <path
                                        d="M512 64C264.6 64 64 264.6 64 512s200.6 448 448 448 448-200.6 448-448S759.4 64 512 64zm-32 232c0-4.4 3.6-8 8-8h48c4.4 0 8 3.6 8 8v224c0 4.4-3.6 8-8 8h-48c-4.4 0-8-3.6-8-8V296zm32 440c-26.5 0-48-21.5-48-48s21.5-48 48-48 48 21.5 48 48-21.5 48-48 48z" />
                                </svg>
                            </span>
                            <span class="login-msg-icon login-msg-icon-ok" aria-hidden="true">
                                <svg viewBox="64 64 896 896" focusable="false" data-icon="check-circle"
                                    width="1em" height="1em" fill="currentColor" aria-hidden="true">
                                    <path
                                        d="M699 353h-46.9c-10.2 0-19.9 4.9-25.9 13.3L469 584.3l-71.2-98.8c-6-8.3-15.6-13.3-25.9-13.3H325c-6.5 0-10.3 7.4-6.5 12.7l124.6 172.8a31.8 31.8 0 0 0 51.7 0l210.6-292c3.9-5.3.1-12.7-6.4-12.7z" />
                                    <path
