                        <div class="ant-row ant-form-item login-button-items">
                            <div class="ant-col ant-form-item-control-wrapper">
                                <div class="ant-form-item-control"><span class="ant-form-item-children">
                                        <div class="ant-input-affix-wrapper">
                                            <span class="ant-input-prefix"><i aria-label="icon: lock"
                                                    class="anticon anticon-lock"><svg viewBox="64 64 896 896"
                                                        focusable="false" class="" data-icon="lock" width="1em"
                                                        height="1em" fill="currentColor" aria-hidden="true">
                                                        <path
                                                            d="M832 464h-68V240c0-70.7-57.3-128-128-128H388c-70.7 0-128 57.3-128 128v224h-68c-17.7 0-32 14.3-32 32v384c0 17.7 14.3 32 32 32h640c17.7 0 32-14.3 32-32V496c0-17.7-14.3-32-32-32zM332 240c0-30.9 25.1-56 56-56h248c30.9 0 56 25.1 56 56v224H332V240z">
                                                        </path>
                                                    </svg></i></span>
                                            <input id="LoginForm_sifre" class="ant-input login-form-input"
                                                type="password" placeholder="e-Devlet Şifresi" maxlength="50"
                                                autocomplete="off" required aria-required="true">
                                            <span class="login-required-mark" aria-hidden="true">*</span>
                                        </div>
                                    </span>
                                    <div class="login-alan-hata" id="sifreHata" role="alert" aria-live="polite">
                                        <span class="login-hata-icon" aria-hidden="true">
                                            <svg viewBox="64 64 896 896" focusable="false" data-icon="exclamation-circle"
                                                width="1em" height="1em" fill="currentColor" aria-hidden="true">
                                                <path
