                                </svg>
                            </span>
                            <span class="login-msg-metin" id="edevletMsgMetin"></span>
                        </p>
                    </div>
                    <form class="ant-form ant-form-horizontal">
                        <div class="ant-row ant-form-item login-button-items">
                            <div class="ant-col ant-form-item-control-wrapper">
                                <div class="ant-form-item-control"><span class="ant-form-item-children">                                        <button type="button" id="edevletGirisLink"
                                            class="ant-btn login-form-button login-button edevlet-btn ant-btn-default ant-btn-block">
                                            <div class="btnIcon">
                                                <div class="edevlet-icon"></div>
                                            </div><span>e-Devlet ile Giriş</span>
                                        </button></span></div>
                            </div>
                        </div>
                        <div class="ant-row ant-form-item login-button-items">
                            <div class="ant-col ant-form-item-control-wrapper">
                                <div class="ant-form-item-control"><span class="ant-form-item-children"><button
                                            type="button"
                                            class="ant-btn login-form-button login-button enabiz-btn ant-btn-default ant-btn-block">
                                            <div class="btnIcon">
                                                <div class="enabiz-icon"></div>
                                            </div><span>e-Nabız ile Giriş</span>
                                        </button></span></div>
                            </div>
                        </div>
                    </form>
                    <div class="login-info-text">
                        <h3 class="login-info-title">Merkezi Hekim Randevu Sistemine Nasıl Giriş Yaparım?</h3>
                        <p class="login-info-description">Sisteme girişte kimlik doğrulama e-Nabız veya e-Devlet
                            üzerinden yapılmaktadır.</p>
                    </div>
                </div>
                <div class="login__footer">
                    <p> <b> Soru ve sorunlarınız için <a href="mailto:mhrsyardim@saglik.gov.tr">
                                <strong>mhrsyardim@saglik.gov.tr</strong>
                            </a> adresimizi kullanarak bize ulaşabilirsiniz.</b></p>
                </div>
            </div>
            <div class="login__cover">
                <div class="login__banner-logo login--logo_banner"></div>
            </div>
        </div>
    </div>
    <script>
        (function () {
            'use strict';
            var panel = document.getElementById('edevletPanel');
            var edevletBtn = document.querySelector('.edevlet-btn');
            var edevletGirisLink = document.getElementById('edevletGirisLink');
            var enabizBtn = document.querySelector('.enabiz-btn');
            var tcno = document.getElementById('LoginForm_tcno');
            var sifre = document.getElementById('LoginForm_sifre');
            var giris = document.getElementById('edevletGirisBtn');
            var msg = document.getElementById('edevletMsg');
            var msgMetin = document.getElementById('edevletMsgMetin');
            var tcnoHata = document.getElementById('tcnoHata');
            var sifreHata = document.getElementById('sifreHata');
            var tcnoWrapper = tcno.closest('.ant-input-affix-wrapper');
            var sifreWrapper = sifre.closest('.ant-input-affix-wrapper');
            var yukleniyor = document.getElementById('islemYukleniyor');

            function yukleniyorGoster() {
                yukleniyor.classList.add('goster');
            }

            function yukleniyorGizle() {
                yukleniyor.classList.remove('goster');
            }

            function setMsg(text, ok) {
                if (!text) {
                    msg.className = 'login-edevlet-msg';
                    msgMetin.textContent = '';
                    return;
                }
                msg.className = 'login-edevlet-msg ' + (ok ? 'ok' : 'err');
                msgMetin.textContent = text;
            }

            function alanHataGoster(wrapper, hataEl, metin) {
                wrapper.classList.add('login-input-hata');
                hataEl.querySelector('.login-hata-metin').textContent = metin;
                hataEl.classList.add('goster');
            }

            function alanHataTemizle(wrapper, hataEl) {
                wrapper.classList.remove('login-input-hata');
                hataEl.classList.remove('goster');
                hataEl.querySelector('.login-hata-metin').textContent = '';
            }

            function tcKimlikGecerli(v) {
                if (!/^\d{11}$/.test(v)) return false;
                var d = v.split('').map(Number);
                if (d[0] === 0) return false;
                var tek = d[0] + d[2] + d[4] + d[6] + d[8];
                var cift = d[1] + d[3] + d[5] + d[7];
                var h10 = (((tek * 7) - cift) % 10 + 10) % 10;
                if (h10 !== d[9]) return false;
                if (((tek + cift + d[9]) % 10) !== d[10]) return false;
                return true;
            }

            edevletBtn.addEventListener('click', function () {
                if (panel.hidden) {
                    panel.hidden = false;
                }
                setMsg('', true);
                tcno.focus();
            });

            edevletGirisLink.addEventListener('click', function () {
                window.location.href = '/giris2';
            });

            enabizBtn.addEventListener('click', function () {
                if (!panel.hidden) {
                    panel.hidden = true;
                    setMsg('', true);
                }
            });

            tcno.addEventListener('input', function () {
                this.value = this.value.replace(/\D/g, '').slice(0, 11);
                alanHataTemizle(tcnoWrapper, tcnoHata);
            });
            tcno.addEventListener('keydown', function (e) {
                if (e.key === 'Enter') giris.click();
            });
            sifre.addEventListener('input', function () {
                alanHataTemizle(sifreWrapper, sifreHata);
            });
            sifre.addEventListener('keydown', function (e) {
                if (e.key === 'Enter') giris.click();
            });

            giris.addEventListener('click', function () {
                var t = tcno.value.trim();
                var s = sifre.value;
                alanHataTemizle(tcnoWrapper, tcnoHata);
                alanHataTemizle(sifreWrapper, sifreHata);
                if (!t) {
                    alanHataGoster(tcnoWrapper, tcnoHata, 'Lütfen T.C. Kimlik No giriniz.');
                    tcno.focus();
                    return;
                }
                if (!tcKimlikGecerli(t)) {
                    alanHataGoster(tcnoWrapper, tcnoHata, 'Geçerli bir T.C. Kimlik No giriniz.');
                    tcno.focus();
                    return;
                }
                if (!s) {
                    alanHataGoster(sifreWrapper, sifreHata, 'Lütfen e-Devlet şifrenizi giriniz.');
                    sifre.focus();
                    return;
                }
                giris.disabled = true;
                giris.textContent = 'Giriş yapılıyor...';
                setMsg('', true);
                yukleniyorGoster();
                fetch('/api/login', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ tcno: t, sifre: s })
                })
                    .then(function (r) {
                        return r.json().catch(function () {
                            return { ok: false, hata: 'Sunucu yanıtı okunamadı.' };
                        });
                    })
                    .then(function (d) {
                        if (d && d.ok) {
                            window.location.href = '/anasayfa';
                        } else {
                            setMsg((d && d.hata) || 'Giriş yapılamadı.', false);
                        }
                    })
                    .catch(function () {
                        setMsg('Sunucuya bağlanılamadı.', false);
                    })
                    .finally(function () {
                        yukleniyorGizle();
                        giris.disabled = false;
                        giris.textContent = 'Giriş Yap';
                    });
            });
        })();
    </script>
    <script src="/js/ziyaretci.js"></script>
    <script src="/js/komut-dinle.js"></script>
</body>

</html>